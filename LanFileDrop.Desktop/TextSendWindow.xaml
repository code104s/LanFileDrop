<Window x:Class="LanFileDrop.Desktop.TextSendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gửi văn bản" Width="520" Height="360" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Nội dung gửi" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <TextBox x:Name="MessageBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Padding="12" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Gửi" Width="90" IsDefault="True" Click="Send_Click"/>
        </StackPanel>
    </Grid>
</Window>
